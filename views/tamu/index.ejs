<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
  <div>
    <h4 class="fw-bold mb-1">Buku Tamu Front Office</h4>
    <p class="text-muted small mb-0">Registrasi pengunjung, asal instansi/sekolah, dan riwayat penyerahan berkas</p>
  </div>
  <div class="mt-3 mt-md-0 d-flex gap-2">
    <a href="/tamu/create" class="btn btn-success btn-sm">
      <i class="bi bi-person-plus me-1"></i> Registrasi Tamu Baru
    </a>
  </div>
</div>

<!-- Search -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <form action="/tamu" method="GET" class="row g-2 align-items-center">
      <div class="col-md-10">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
          <input type="text" name="search" class="form-control" placeholder="Cari nama tamu, asal sekolah/unit kerja, NIP, atau ID Tamu..." value="<%= search %>">
        </div>
      </div>
      <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-sm btn-dark">Cari</button>
      </div>
    </form>
  </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
        <thead class="table-light">
          <tr>
            <th style="width: 100px;">ID Tamu</th>
            <th>Nama Lengkap</th>
            <th>NIP</th>
            <th>Jabatan & Pekerjaan</th>
            <th>Asal Unit Kerja / Sekolah</th>
            <th>No. Kontak / WA</th>
            <th>Berkas</th>
            <th class="text-end" style="width: 130px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (items && items.length > 0) { %>
            <% items.forEach(t => { %>
              <tr>
                <td><span class="badge badge-soft-primary font-monospace fw-bold"><%= t.id_tamu %></span></td>
                <td>
                  <a href="/tamu/<%= t.id %>" class="fw-bold text-dark text-decoration-none">
                    <%= t.nama %>
                  </a>
                </td>
                <td class="text-muted small font-monospace"><%= t.nip && t.nip !== '-' ? t.nip : '-' %></td>
                <td>
                  <div><%= t.jabatan || '-' %></div>
                  <small class="text-muted"><%= t.pekerjaan || '-' %></small>
                </td>
                <td class="fw-semibold text-secondary"><%= t.unit_kerja || '-' %></td>
                <td>
                  <% if (t.no_kontak && t.no_kontak !== '-') { %>
                    <% const cleanPhone = String(t.no_kontak).replace(/[^0-9]/g, ''); %>
                    <% const waPhone = cleanPhone.startsWith('0') ? '62' + cleanPhone.substring(1) : cleanPhone; %>
                    <a href="https://wa.me/<%= waPhone %>" target="_blank" class="btn btn-sm btn-outline-success py-0 px-2" style="font-size: 0.775rem;">
                      <i class="bi bi-whatsapp me-1"></i><%= t.no_kontak %>
                    </a>
                  <% } else { %>
                    <span class="text-muted small">-</span>
                  <% } %>
                </td>
                <td>
                  <% const berkasCount = t.TransaksiBerkas ? t.TransaksiBerkas.length : 0; %>
                  <span class="badge <%= berkasCount > 0 ? 'badge-soft-success' : 'badge-soft-secondary' %>">
                    <%= berkasCount %> Berkas
                  </span>
                </td>
                <td class="text-end text-nowrap">
                  <div class="btn-group btn-group-sm">
                    <a href="/tamu/<%= t.id %>" class="btn btn-outline-primary py-0 px-2" title="Detail & Riwayat">
                      <i class="bi bi-eye"></i>
                    </a>
                    <a href="/transaksi-berkas/create?tamuId=<%= t.id %>" class="btn btn-outline-success py-0 px-2" title="Terima Berkas dari Tamu Ini">
                      <i class="bi bi-file-earmark-plus"></i>
                    </a>
                    <form action="/tamu/<%= t.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Hapus data tamu <%= t.nama %>?')">
                      <button type="submit" class="btn btn-outline-danger py-0 px-2" title="Hapus"><i class="bi bi-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center text-muted py-4">Tidak ada data tamu ditemukan</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="d-flex align-items-center justify-content-between p-3 border-top">
        <small class="text-muted">Halaman <%= currentPage %> dari <%= totalPages %> (Total <%= totalCount %> tamu)</small>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/tamu?page=<%= currentPage - 1 %>&search=<%= search %>">Sebelumnya</a>
          </li>
          <li class="page-item active">
            <span class="page-link bg-success border-success"><%= currentPage %></span>
          </li>
          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/tamu?page=<%= currentPage + 1 %>&search=<%= search %>">Selanjutnya</a>
          </li>
        </ul>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
