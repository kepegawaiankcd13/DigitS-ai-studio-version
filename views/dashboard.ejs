<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
  <div>
    <h4 class="fw-bold mb-1">Dashboard Persuratan & Front Office</h4>
    <p class="text-muted small mb-0">Selamat datang kembali, <strong><%= user.nama_lengkap || user.username %></strong> (<%= user.role %>) — Data Tahun <%= tahun %></p>
  </div>
  <div class="mt-3 mt-md-0 d-flex gap-2">
    <a href="/transaksi-surat/create" class="btn btn-success btn-sm">
      <i class="bi bi-hash me-1"></i> Ambil Nomor Surat
    </a>
    <a href="/surat-masuk/create" class="btn btn-outline-success btn-sm">
      <i class="bi bi-inbox me-1"></i> Catat Surat Masuk
    </a>
    <a href="/tamu/create" class="btn btn-primary btn-sm">
      <i class="bi bi-person-plus me-1"></i> Tamu Baru
    </a>
  </div>
</div>

<!-- Statistics Cards -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-xl-3">
    <div class="card card-stat p-3 h-100">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="text-muted small fw-semibold text-uppercase">Surat Masuk (<%= tahun %>)</span>
        <div class="rounded-3 p-2 bg-primary-subtle text-primary">
          <i class="bi bi-inbox-fill fs-5"></i>
        </div>
      </div>
      <div class="fs-3 fw-bold text-dark"><%= stats.totalSuratMasuk %></div>
      <div class="mt-2 small text-muted d-flex align-items-center gap-2">
        <span class="badge badge-soft-success"><i class="bi bi-check-circle me-1"></i><%= stats.suratSudahDisposisi %> Disposisi</span>
        <span class="badge badge-soft-warning"><i class="bi bi-clock me-1"></i><%= stats.suratBelumDisposisi %> Menunggu</span>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card card-stat p-3 h-100">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="text-muted small fw-semibold text-uppercase">Nomor Surat Keluar</span>
        <div class="rounded-3 p-2 bg-success-subtle text-success">
          <i class="bi bi-send-fill fs-5"></i>
        </div>
      </div>
      <div class="fs-3 fw-bold text-dark"><%= stats.totalSuratKeluar %></div>
      <div class="mt-2 small text-muted d-flex align-items-center gap-2">
        <span class="badge badge-soft-success"><%= stats.suratAktif %> Aktif</span>
        <span class="badge badge-soft-warning"><%= stats.suratBooking %> Booking</span>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card card-stat p-3 h-100">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="text-muted small fw-semibold text-uppercase">Buku Tamu Terdata</span>
        <div class="rounded-3 p-2 bg-info-subtle text-info">
          <i class="bi bi-people-fill fs-5"></i>
        </div>
      </div>
      <div class="fs-3 fw-bold text-dark"><%= stats.totalTamu %></div>
      <div class="mt-2 small text-muted">
        <a href="/tamu" class="text-decoration-none text-info fw-semibold">Lihat Semua Tamu <i class="bi bi-arrow-right"></i></a>
      </div>
    </div>
  </div>

  <div class="col-sm-6 col-xl-3">
    <div class="card card-stat p-3 h-100">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="text-muted small fw-semibold text-uppercase">Transaksi Berkas</span>
        <div class="rounded-3 p-2 bg-warning-subtle text-warning">
          <i class="bi bi-folder-check fs-5"></i>
        </div>
      </div>
      <div class="fs-3 fw-bold text-dark"><%= stats.totalTransaksiBerkas %></div>
      <div class="mt-2 small text-muted">
        <a href="/transaksi-berkas" class="text-decoration-none text-warning fw-semibold">Lihat Berkas Masuk <i class="bi bi-arrow-right"></i></a>
      </div>
    </div>
  </div>
</div>

<!-- Recent Tables -->
<div class="row g-4 mb-4">
  <!-- Recent Surat Masuk -->
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-inbox text-primary me-2"></i>Surat Masuk Terbaru</h6>
        <a href="/surat-masuk" class="btn btn-sm btn-light border py-1 small">Lihat Semua</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
          <thead class="table-light">
            <tr>
              <th>Tgl Terima</th>
              <th>Pengirim & Perihal</th>
              <th>Disposisi</th>
              <th class="text-end">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentSuratMasuk && recentSuratMasuk.length > 0) { %>
              <% recentSuratMasuk.forEach(s => { %>
                <tr>
                  <td class="text-nowrap fw-semibold"><%= s.tgl_terima %></td>
                  <td>
                    <div class="fw-bold text-truncate" style="max-width: 250px;"><%= s.pengirim %></div>
                    <div class="text-muted small text-truncate" style="max-width: 250px;"><%= s.perihal %></div>
                  </td>
                  <td>
                    <% if (s.status_disposisi == 1 || s.status_disposisi === true) { %>
                      <span class="badge badge-soft-success">Sudah</span>
                    <% } else { %>
                      <span class="badge badge-soft-warning">Belum</span>
                    <% } %>
                  </td>
                  <td class="text-end text-nowrap">
                    <a href="/surat-masuk/<%= s.id %>/disposisi" class="btn btn-sm btn-outline-primary py-0 px-2" title="Disposisi"><i class="bi bi-pencil-square"></i></a>
                    <% if (s.file_pdf) { %>
                      <a href="/uploads/surat_masuk/<%= s.file_pdf %>" target="_blank" class="btn btn-sm btn-outline-danger py-0 px-2" title="Unduh PDF"><i class="bi bi-file-earmark-pdf"></i></a>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="4" class="text-center text-muted py-3">Belum ada surat masuk</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Recent Nomor Surat Keluar -->
  <div class="col-lg-6">
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-hash text-success me-2"></i>Nomor Surat Keluar Terbaru</h6>
        <a href="/transaksi-surat" class="btn btn-sm btn-light border py-1 small">Lihat Semua</a>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
          <thead class="table-light">
            <tr>
              <th>Nomor Surat</th>
              <th>Perihal</th>
              <th>Status</th>
              <th class="text-end">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentTransaksiSurat && recentTransaksiSurat.length > 0) { %>
              <% recentTransaksiSurat.forEach(ts => { %>
                <tr>
                  <td class="fw-bold text-success text-nowrap"><%= ts.nomor_lengkap || ts.nomor_urut %></td>
                  <td>
                    <div class="text-truncate" style="max-width: 250px;"><%= ts.perihal || '(Belum diisi)' %></div>
                    <small class="text-muted"><%= ts.tanggal_nomor %></small>
                  </td>
                  <td>
                    <% if (ts.status === 'Aktif') { %>
                      <span class="badge badge-soft-success">Aktif</span>
                    <% } else { %>
                      <span class="badge badge-soft-warning">Booking</span>
                    <% } %>
                  </td>
                  <td class="text-end text-nowrap">
                    <% if (ts.file_pdf) { %>
                      <a href="/uploads/surat_masuk/<%= ts.file_pdf %>" target="_blank" class="btn btn-sm btn-outline-danger py-0 px-2"><i class="bi bi-file-earmark-pdf"></i></a>
                    <% } else { %>
                      <span class="text-muted small">-</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="4" class="text-center text-muted py-3">Belum ada data penomoran</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Recent Transaksi Berkas Tamu -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
    <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-file-earmark-arrow-down text-warning me-2"></i>Penerimaan Berkas Tamu Terkini (Front Office)</h6>
    <a href="/transaksi-berkas" class="btn btn-sm btn-light border py-1 small">Lihat Semua Berkas</a>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
      <thead class="table-light">
        <tr>
          <th>Tgl Transaksi</th>
          <th>Nama Tamu / Asal Sekolah</th>
          <th>Perihal Berkas</th>
          <th>Tujuan</th>
          <th>Penerima (FO)</th>
          <th class="text-end">Aksi</th>
        </tr>
      </thead>
      <tbody>
        <% if (recentBerkas && recentBerkas.length > 0) { %>
          <% recentBerkas.forEach(b => { %>
            <tr>
              <td class="text-nowrap fw-semibold"><%= String(b.tgl_transaksi || '').substring(0, 10) %></td>
              <td>
                <div class="fw-bold"><%= b.Tamu ? b.Tamu.nama : '-' %></div>
                <small class="text-muted"><%= b.Tamu ? b.Tamu.unit_kerja : '-' %></small>
              </td>
              <td>
                <div class="text-truncate" style="max-width: 320px;"><%= b.perihal %></div>
              </td>
              <td><span class="badge badge-soft-info"><%= b.tujuan %></span></td>
              <td><%= b.penerima %></td>
              <td class="text-end text-nowrap">
                <a href="/transaksi-berkas/<%= b.id %>/cetak" target="_blank" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Cetak Tanda Terima"><i class="bi bi-printer"></i></a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="6" class="text-center text-muted py-3">Belum ada berkas masuk</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
