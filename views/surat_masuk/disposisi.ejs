<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
  <div>
    <h4 class="fw-bold mb-1">Lembar Disposisi Pimpinan</h4>
    <p class="text-muted small mb-0">Pengaturan disposisi dan instruksi tindak lanjut surat masuk</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/surat-masuk/<%= item.id %>/cetak-disposisi" target="_blank" class="btn btn-sm btn-outline-primary">
      <i class="bi bi-printer me-1"></i> Cetak Lembar Disposisi
    </a>
    <a href="/surat-masuk" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
  </div>
</div>

<div class="row g-4">
  <div class="col-lg-5">
    <!-- Letter Details Card -->
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white py-3 border-bottom">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-file-earmark-text text-primary me-2"></i>Rincian Surat Masuk</h6>
      </div>
      <div class="card-body p-3" style="font-size: 0.875rem;">
        <table class="table table-sm table-borderless mb-0">
          <tr>
            <td class="text-muted" style="width: 120px;">No. Agenda:</td>
            <td class="fw-bold">#<%= item.id %></td>
          </tr>
          <tr>
            <td class="text-muted">No. Surat:</td>
            <td class="fw-bold font-monospace text-primary"><%= item.nomor_surat %></td>
          </tr>
          <tr>
            <td class="text-muted">Tgl. Surat:</td>
            <td><%= item.tgl_surat %></td>
          </tr>
          <tr>
            <td class="text-muted">Tgl. Diterima:</td>
            <td><%= item.tgl_terima %></td>
          </tr>
          <tr>
            <td class="text-muted">Pengirim:</td>
            <td class="fw-semibold"><%= item.pengirim %></td>
          </tr>
          <tr>
            <td class="text-muted">Perihal:</td>
            <td><%= item.perihal %></td>
          </tr>
          <tr>
            <td class="text-muted">Urgensi:</td>
            <td><span class="badge badge-soft-warning"><%= item.urgensi %></span></td>
          </tr>
          <tr>
            <td class="text-muted">Sifat:</td>
            <td><span class="badge badge-soft-info"><%= item.sifat %></span></td>
          </tr>
          <% if (item.file_pdf) { %>
            <tr>
              <td class="text-muted">Berkas:</td>
              <td>
                <a href="/uploads/surat_masuk/<%= item.file_pdf %>" target="_blank" class="btn btn-sm btn-outline-danger py-0 px-2">
                  <i class="bi bi-file-earmark-pdf me-1"></i>Buka PDF Surat
                </a>
              </td>
            </tr>
          <% } %>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <!-- Disposisi Form -->
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white py-3 border-bottom">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-pencil-square text-success me-2"></i>Instruksi & Disposisi</h6>
      </div>
      <div class="card-body p-4">
        <form action="/surat-masuk/<%= item.id %>/disposisi" method="POST">
          
          <div class="mb-3">
            <label class="form-label fw-semibold small">Tujuan Disposisi (Pejabat / Bagian)</label>
            <div class="row g-2 mb-2">
              <% const tujuans = ['Kasubag Tata Usaha', 'Kasi Pelayanan SMA', 'Kasi Pelayanan SMK', 'Kasi PKLK', 'Pejabat Pembuat Komitmen (PPK)', 'Bendahara Pengeluaran', 'Kepegawaian', 'Arsiparis']; %>
              <% tujuans.forEach(t => { %>
                <div class="col-sm-6">
                  <div class="form-check small">
                    <input class="form-check-input disposisi-chk" type="checkbox" value="<%= t %>" id="chk_<%= t.replace(/\s+/g, '_') %>"
                      <%= (item.tujuan_disposisi && item.tujuan_disposisi.includes(t)) ? 'checked' : '' %>>
                    <label class="form-check-label" for="chk_<%= t.replace(/\s+/g, '_') %>"><%= t %></label>
                  </div>
                </div>
              <% }) %>
            </div>
            <input type="text" name="tujuan_disposisi" id="tujuanDisposisiInput" class="form-control form-control-sm mt-2" 
              placeholder="Atau ketik pejabat / staf tujuan disposisi..." value="<%= item.tujuan_disposisi || '' %>" required>
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold small">Catatan / Petunjuk Instruksi Pimpinan</label>
            <div class="d-flex gap-1 flex-wrap mb-2">
              <button type="button" class="btn btn-sm btn-light border py-0 px-2 small" onclick="addCatatan('Tindak lanjuti segera')">+ Tindak lanjuti segera</button>
              <button type="button" class="btn btn-sm btn-light border py-0 px-2 small" onclick="addCatatan('Untuk diketahui / pedoman')">+ Untuk diketahui</button>
              <button type="button" class="btn btn-sm btn-light border py-0 px-2 small" onclick="addCatatan('Siapkan konsep jawaban / tanggapan')">+ Konsep jawaban</button>
              <button type="button" class="btn btn-sm btn-light border py-0 px-2 small" onclick="addCatatan('Hadir / Wakili')">+ Hadiri / Wakili</button>
              <button type="button" class="btn btn-sm btn-light border py-0 px-2 small" onclick="addCatatan('Arsipkan')">+ Arsipkan</button>
            </div>
            <textarea name="catatan_disposisi" id="catatanInput" class="form-control" rows="4" placeholder="Tulis instruksi tindak lanjut pimpinan di sini..."><%= item.catatan_disposisi || '' %></textarea>
          </div>

          <div class="mb-4">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="status_disposisi" value="1" id="switchStatus" <%= (item.status_disposisi == 1 || item.status_disposisi === true) ? 'checked' : 'checked' %>>
              <label class="form-check-label fw-semibold small" for="switchStatus">Tandai status sudah didisposisikan</label>
            </div>
          </div>

          <div class="d-flex justify-content-end gap-2">
            <a href="/surat-masuk" class="btn btn-light">Batal</a>
            <button type="submit" class="btn btn-success px-4">
              <i class="bi bi-save me-1"></i> Simpan Disposisi
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function addCatatan(text) {
    const area = document.getElementById('catatanInput');
    if (area.value.trim() === '') {
      area.value = text;
    } else {
      area.value += '; ' + text;
    }
  }

  document.querySelectorAll('.disposisi-chk').forEach(chk => {
    chk.addEventListener('change', () => {
      const selected = Array.from(document.querySelectorAll('.disposisi-chk:checked')).map(c => c.value);
      document.getElementById('tujuanDisposisiInput').value = selected.join(', ');
    });
  });
</script>

<%- include('../partials/footer') %>
