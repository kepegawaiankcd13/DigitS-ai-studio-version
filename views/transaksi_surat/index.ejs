<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
  <div>
    <h4 class="fw-bold mb-1">Nomor Surat Keluar</h4>
    <p class="text-muted small mb-0">Kelola penomoran dinas, booking nomor, dan arsip dokumen surat keluar</p>
  </div>
  <div class="mt-3 mt-md-0 d-flex gap-2">
    <a href="/transaksi-surat/export" class="btn btn-outline-success btn-sm">
      <i class="bi bi-file-earmark-excel me-1"></i> Ekspor Excel
    </a>
    <a href="/transaksi-surat/create" class="btn btn-success btn-sm">
      <i class="bi bi-plus-circle me-1"></i> Ambil Nomor Baru
    </a>
  </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <form action="/transaksi-surat" method="GET" class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
          <input type="text" name="search" class="form-control" placeholder="Cari nomor surat atau perihal..." value="<%= search %>">
        </div>
      </div>
      <div class="col-md-3">
        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">Semua Status</option>
          <option value="Aktif" <%= status === 'Aktif' ? 'selected' : '' %>>Aktif (Terpakai)</option>
          <option value="Booking" <%= status === 'Booking' ? 'selected' : '' %>>Booking</option>
        </select>
      </div>
      <div class="col-md-3">
        <select name="jenisId" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">Semua Jenis Surat</option>
          <% jenisSurats.forEach(j => { %>
            <option value="<%= j.id %>" <%= String(jenisId) === String(j.id) ? 'selected' : '' %>><%= j.nama_jenis %> (<%= j.kode_jenis %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-1 d-grid">
        <button type="submit" class="btn btn-sm btn-dark">Filter</button>
      </div>
    </form>
  </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
        <thead class="table-light">
          <tr>
            <th style="width: 70px;">No. Urut</th>
            <th>Nomor Surat Lengkap</th>
            <th>Tanggal</th>
            <th>Perihal & Klasifikasi</th>
            <th>Status</th>
            <th>File PDF</th>
            <th>Petugas</th>
            <th class="text-end" style="width: 120px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (items && items.length > 0) { %>
            <% items.forEach(item => { %>
              <tr>
                <td class="fw-bold text-muted"><%= item.nomor_urut %></td>
                <td>
                  <span class="fw-bold text-success font-monospace fs-6"><%= item.nomor_lengkap || item.nomor_urut %></span>
                  <% if (item.JenisSurat) { %>
                    <span class="badge badge-soft-info ms-1"><%= item.JenisSurat.kode_jenis %></span>
                  <% } %>
                </td>
                <td class="text-nowrap text-secondary"><%= item.tanggal_nomor %></td>
                <td>
                  <div class="fw-semibold text-dark"><%= item.perihal || '(Nomor Belum Digunakan)' %></div>
                  <% if (item.Klasifikasi) { %>
                    <small class="text-muted d-block"><%= item.Klasifikasi.kode %> - <%= item.Klasifikasi.nama %></small>
                  <% } %>
                </td>
                <td>
                  <% if (item.status === 'Aktif') { %>
                    <span class="badge badge-soft-success"><i class="bi bi-check-circle me-1"></i>Aktif</span>
                  <% } else { %>
                    <span class="badge badge-soft-warning"><i class="bi bi-bookmark me-1"></i>Booking</span>
                  <% } %>
                </td>
                <td>
                  <% if (item.file_pdf) { %>
                    <a href="/uploads/surat_masuk/<%= item.file_pdf %>" target="_blank" class="btn btn-sm btn-outline-danger py-0 px-2" title="Buka Dokumen PDF">
                      <i class="bi bi-file-earmark-pdf me-1"></i>PDF
                    </a>
                  <% } else { %>
                    <span class="text-muted small">Tidak ada</span>
                  <% } %>
                </td>
                <td>
                  <small class="text-muted"><%= item.User ? item.User.nama_lengkap : '-' %></small>
                </td>
                <td class="text-end text-nowrap">
                  <% if (item.status === 'Booking') { %>
                    <button class="btn btn-sm btn-outline-success py-0 px-2 me-1" title="Lengkapi / Pakai Nomor" data-bs-toggle="modal" data-bs-target="#completeModal<%= item.id %>">
                      <i class="bi bi-check-lg"></i>
                    </button>
                  <% } %>
                  <form action="/transaksi-surat/<%= item.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus nomor ini?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Hapus"><i class="bi bi-trash"></i></button>
                  </form>
                </td>
              </tr>

              <!-- Modal Complete Booking -->
              <% if (item.status === 'Booking') { %>
                <div class="modal fade" id="completeModal<%= item.id %>" tabindex="-1">
                  <div class="modal-dialog">
                    <div class="modal-content">
                      <form action="/transaksi-surat/<%= item.id %>/complete" method="POST" enctype="multipart/form-data">
                        <div class="modal-header">
                          <h6 class="modal-title fw-bold">Lengkapi Pemakaian Nomor <%= String(item.nomor_urut).padStart(4, '0') %></h6>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                          <div class="mb-3">
                            <label class="form-label small fw-semibold">Kode Klasifikasi Arsip</label>
                            <input type="text" class="form-control form-control-sm klas-search" data-target="klasId<%= item.id %>" placeholder="Ketik kode atau nama klasifikasi..." required>
                            <input type="hidden" name="klasifikasiId" id="klasId<%= item.id %>" required>
                            <div class="form-text small klas-selected-label text-success"></div>
                          </div>
                          <div class="mb-3">
                            <label class="form-label small fw-semibold">Perihal Surat</label>
                            <textarea name="perihal" class="form-control form-control-sm" rows="3" placeholder="Masukkan perihal surat..." required></textarea>
                          </div>
                          <div class="mb-3">
                            <label class="form-label small fw-semibold">Upload Berkas PDF (Opsional)</label>
                            <input type="file" name="file_pdf" class="form-control form-control-sm" accept="application/pdf">
                          </div>
                        </div>
                        <div class="modal-footer">
                          <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Batal</button>
                          <button type="submit" class="btn btn-sm btn-success">Gunakan Nomor</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              <% } %>

            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center text-muted py-4">Tidak ada data transaksi penomoran surat</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="d-flex align-items-center justify-content-between p-3 border-top">
        <small class="text-muted">Menampilkan halaman <%= currentPage %> dari <%= totalPages %> (Total <%= totalCount %> data)</small>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/transaksi-surat?page=<%= currentPage - 1 %>&search=<%= search %>&status=<%= status %>&jenisId=<%= jenisId %>">Sebelumnya</a>
          </li>
          <li class="page-item active">
            <span class="page-link bg-success border-success"><%= currentPage %></span>
          </li>
          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/transaksi-surat?page=<%= currentPage + 1 %>&search=<%= search %>&status=<%= status %>&jenisId=<%= jenisId %>">Selanjutnya</a>
          </li>
        </ul>
      </div>
    <% } %>
  </div>
</div>

<script>
  document.querySelectorAll('.klas-search').forEach(input => {
    input.addEventListener('input', async function() {
      const q = this.value;
      const targetId = this.dataset.target;
      const label = this.parentElement.querySelector('.klas-selected-label');
      if (q.length < 2) return;
      try {
        const res = await fetch('/api/klasifikasi/search?q=' + encodeURIComponent(q));
        const list = await res.json();
        if (list.length > 0) {
          document.getElementById(targetId).value = list[0].id;
          label.textContent = 'Dipilih: ' + list[0].kode + ' - ' + list[0].nama;
        }
      } catch (e) {}
    });
  });
</script>

<%- include('../partials/footer') %>
