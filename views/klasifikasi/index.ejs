<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
  <div>
    <h4 class="fw-bold mb-1">Kode Klasifikasi Arsip</h4>
    <p class="text-muted small mb-0">Daftar kode klasifikasi naskah dinas dan arsip (Permendagri / Jadwal Retensi Arsip)</p>
  </div>
</div>

<!-- Search -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <form action="/klasifikasi" method="GET" class="row g-2 align-items-center">
      <div class="col-md-10">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
          <input type="text" name="search" class="form-control" placeholder="Cari kode (misal: HM, TU.04, PK) atau perihal klasifikasi..." value="<%= search %>">
        </div>
      </div>
      <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-sm btn-dark">Cari</button>
      </div>
    </form>
  </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
        <thead class="table-light">
          <tr>
            <th style="width: 140px;">Kode Klasifikasi</th>
            <th>Uraian / Deskripsi Klasifikasi</th>
          </tr>
        </thead>
        <tbody>
          <% if (items && items.length > 0) { %>
            <% items.forEach(k => { %>
              <tr>
                <td><span class="badge badge-soft-primary font-monospace fw-bold" style="font-size: 0.825rem;"><%= k.kode %></span></td>
                <td class="fw-medium text-dark"><%= k.nama %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="2" class="text-center text-muted py-4">Kode klasifikasi tidak ditemukan</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="d-flex align-items-center justify-content-between p-3 border-top">
        <small class="text-muted">Halaman <%= currentPage %> dari <%= totalPages %> (Total <%= totalCount %> data klasifikasi)</small>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/klasifikasi?page=<%= currentPage - 1 %>&search=<%= search %>">Sebelumnya</a>
          </li>
          <li class="page-item active">
            <span class="page-link bg-success border-success"><%= currentPage %></span>
          </li>
          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/klasifikasi?page=<%= currentPage + 1 %>&search=<%= search %>">Selanjutnya</a>
          </li>
        </ul>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
