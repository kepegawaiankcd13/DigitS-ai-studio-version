<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | DigitS KCD XIII' : 'DigitS - Cabang Dinas Pendidikan Wilayah XIII' %></title>
  <link rel="icon" type="image/png" href="/images/logo-jabar.png">
  
  <!-- Bootstrap 5 CSS & Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Google Fonts: Plus Jakarta Sans (Editorial & Clean Interface) & JetBrains Mono for Tabular -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      /* Brand Color Harmony - Jabar Emerald & Modern Slate */
      --primary: #0F6B59;
      --primary-dark: #0A4B3E;
      --primary-light: #EBF7F4;
      --primary-hover: #0B4F43;
      --primary-glow: rgba(15, 107, 89, 0.12);
      
      --accent-amber: #D97706;
      --accent-blue: #2563EB;
      --accent-indigo: #4F46E5;
      
      --canvas: #F8FAFC;
      --surface: #FFFFFF;
      --border-color: #E2E8F0;
      --border-subtle: #F1F5F9;
      
      --text-main: #0F172A;
      --text-muted: #64748B;
      --text-subtle: #94A3B8;

      --sidebar-width: 256px;
      --header-height: 64px;
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--canvas);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      font-size: 0.875rem;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }

    /* Tabular numbers for clean data alignment */
    .font-tabular {
      font-family: 'JetBrains Mono', monospace;
      font-variant-numeric: tabular-nums;
    }

    /* Layout Hierarchy */
    .app-container {
      display: flex;
      flex: 1;
      min-height: calc(100vh - var(--header-height));
    }

    .app-sidebar {
      width: var(--sidebar-width);
      background: var(--surface);
      border-right: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      position: sticky;
      top: var(--header-height);
      height: calc(100vh - var(--header-height));
      overflow-y: auto;
      z-index: 990;
    }

    .app-content {
      flex: 1;
      padding: 1.75rem 2.25rem;
      background: var(--canvas);
      overflow-x: hidden;
      max-width: 1600px;
      margin: 0 auto;
      width: 100%;
    }

    /* Glassmorphism Navbar */
    .top-navbar {
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-color);
      height: var(--header-height);
      z-index: 1000;
      transition: all 0.2s ease;
    }

    /* Clean Card Elevation */
    .card-modern {
      background: var(--surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.03), 0 1px 2px -1px rgba(0, 0, 0, 0.02);
      transition: transform 0.18s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.18s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.18s ease;
    }

    .card-modern:hover {
      box-shadow: 0 6px 18px -2px rgba(15, 107, 89, 0.06), 0 2px 6px -1px rgba(0, 0, 0, 0.04);
      border-color: #CBD5E1;
    }

    /* KPI Stat Cards */
    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 1.25rem 1.4rem;
      position: relative;
      overflow: hidden;
      transition: all 0.18s ease;
    }

    .stat-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px -3px rgba(15, 107, 89, 0.08);
      border-color: #CBD5E1;
    }

    .stat-icon-wrapper {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      flex-shrink: 0;
      transition: transform 0.2s ease;
    }

    .stat-card:hover .stat-icon-wrapper {
      transform: scale(1.05);
    }

    /* Buttons */
    .btn-primary-custom {
      background: linear-gradient(180deg, #107864 0%, #0B4F43 100%);
      border: 1px solid #094237;
      color: #FFFFFF;
      font-weight: 600;
      border-radius: var(--radius-sm);
      padding: 0.5rem 1.15rem;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
      transition: all 0.16s ease;
    }

    .btn-primary-custom:hover {
      background: linear-gradient(180deg, #0D6957 0%, #083D33 100%);
      color: #FFFFFF;
      transform: translateY(-1px);
      box-shadow: 0 4px 10px rgba(15, 107, 89, 0.25);
    }

    .btn-outline-custom {
      background: #FFFFFF;
      border: 1px solid var(--border-color);
      color: #334155;
      font-weight: 600;
      border-radius: var(--radius-sm);
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
      transition: all 0.15s ease;
    }

    .btn-outline-custom:hover {
      background: var(--canvas);
      border-color: #94A3B8;
      color: var(--text-main);
    }

    /* Soft Pastel Badges with Great Contrast */
    .badge-soft-emerald {
      background-color: #DEF7EC;
      color: #03543F;
      border: 1px solid #BCF0DA;
      font-weight: 600;
    }

    .badge-soft-amber {
      background-color: #FEF3C7;
      color: #92400E;
      border: 1px solid #FDE68A;
      font-weight: 600;
    }

    .badge-soft-blue {
      background-color: #DBEAFE;
      color: #1E40AF;
      border: 1px solid #BFDBFE;
      font-weight: 600;
    }

    .badge-soft-purple {
      background-color: #F3E8FF;
      color: #6B21A8;
      border: 1px solid #E9D5FF;
      font-weight: 600;
    }

    .badge-soft-slate {
      background-color: #F1F5F9;
      color: #475569;
      border: 1px solid #E2E8F0;
      font-weight: 600;
    }

    .badge-soft-rose {
      background-color: #FFE4E6;
      color: #9F1239;
      border: 1px solid #FECDD3;
      font-weight: 600;
    }

    /* Tables */
    .table-modern {
      margin-bottom: 0;
      font-size: 0.85rem;
    }

    .table-modern thead th {
      background: #F8FAFC;
      color: #475569;
      font-weight: 700;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid var(--border-color);
      padding: 0.8rem 1rem;
      white-space: nowrap;
    }

    .table-modern tbody td {
      padding: 0.85rem 1rem;
      border-bottom: 1px solid var(--border-color);
      vertical-align: middle;
      color: #334155;
    }

    .table-modern tbody tr {
      transition: background-color 0.12s ease;
    }

    .table-modern tbody tr:hover {
      background-color: #F8FCFB;
    }

    /* Form Controls */
    .form-control, .form-select {
      border: 1px solid #CBD5E1;
      border-radius: var(--radius-sm);
      font-size: 0.875rem;
      padding: 0.5rem 0.75rem;
      color: var(--text-main);
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .form-control:focus, .form-select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-glow);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94A3B8;
    }

    @media print {
      .no-print, .top-navbar, .app-sidebar, footer {
        display: none !important;
      }
      .app-content {
        padding: 0 !important;
        background: #FFFFFF !important;
      }
      body {
        background: #FFFFFF !important;
      }
    }
  </style>

  <!-- Iframe Session Preserver Script -->
  <script>
    (function() {
      const serverToken = "<%= typeof authToken !== 'undefined' ? authToken : '' %>";
      const urlParams = new URLSearchParams(window.location.search);
      const urlToken = urlParams.get('auth');
      const activeToken = serverToken || urlToken || sessionStorage.getItem('digits_auth') || localStorage.getItem('digits_auth');

      if (activeToken) {
        sessionStorage.setItem('digits_auth', activeToken);
        localStorage.setItem('digits_auth', activeToken);

        // Keep auth parameter on all navigation links inside iframe
        document.addEventListener('DOMContentLoaded', function() {
          document.querySelectorAll('a[href^="/"]').forEach(function(el) {
            const href = el.getAttribute('href');
            if (href && !href.startsWith('/logout') && !href.includes('auth=')) {
              const sep = href.includes('?') ? '&' : '?';
              el.setAttribute('href', href + sep + 'auth=' + encodeURIComponent(activeToken));
            }
          });

          document.querySelectorAll('form[action^="/"]').forEach(function(el) {
            const action = el.getAttribute('action');
            if (action && !action.includes('auth=') && !el.querySelector('input[name="auth"]')) {
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'auth';
              input.value = activeToken;
              el.appendChild(input);
            }
          });
        });
      }
    })();

    function handleLogout() {
      sessionStorage.removeItem('digits_auth');
      localStorage.removeItem('digits_auth');
      window.location.href = '/logout';
    }
  </script>
</head>
<body>

  <!-- Top Navbar -->
  <nav class="top-navbar px-3 px-lg-4 d-flex align-items-center justify-content-between sticky-top">
    <!-- Left: Mobile Toggle & Brand Logo -->
    <div class="d-flex align-items-center gap-3">
      <button class="btn btn-sm btn-light border d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu" aria-label="Toggle Navigation">
        <i class="bi bi-list fs-5"></i>
      </button>
      
      <a href="/dashboard" class="d-flex align-items-center gap-2 text-decoration-none">
        <img src="/images/logo-jabar.png" alt="Logo Jawa Barat" style="height: 38px; width: auto;" onerror="this.style.display='none'">
        <div>
          <div class="d-flex align-items-center gap-2">
            <span class="fw-bold fs-6 text-dark tracking-tight leading-none">DigitS</span>
            <span class="badge bg-success bg-opacity-10 text-success fw-bold px-1.5 py-0.5 rounded" style="font-size: 0.68rem;">KCD XIII</span>
          </div>
          <small class="text-muted d-block" style="font-size: 0.72rem; line-height: 1.1;">Dinas Pendidikan Provinsi Jawa Barat</small>
        </div>
      </a>
    </div>

    <!-- Right Controls -->
    <div class="d-flex align-items-center gap-2 gap-sm-3">
      <!-- Tahun Anggaran Switcher -->
      <form action="/switch-tahun" method="POST" class="d-inline-flex align-items-center gap-1.5 bg-light border px-2 py-1 rounded-3">
        <i class="bi bi-calendar-event text-secondary" style="font-size: 0.85rem;"></i>
        <label for="tahunSelect" class="form-label mb-0 text-muted small d-none d-md-inline" style="font-size: 0.75rem;">Tahun:</label>
        <select id="tahunSelect" name="tahun" class="form-select form-select-sm border-0 bg-transparent py-0 ps-1 pe-4 fw-bold text-dark" style="width: auto; font-size: 0.825rem; cursor: pointer;" onchange="this.form.submit()">
          <option value="2026" <%= user.tahun == '2026' ? 'selected' : '' %>>2026</option>
          <option value="2025" <%= user.tahun == '2025' ? 'selected' : '' %>>2025</option>
          <option value="2027" <%= user.tahun == '2027' ? 'selected' : '' %>>2027</option>
        </select>
      </form>

      <!-- User Profile Dropdown -->
      <div class="dropdown">
        <button class="btn btn-sm btn-white border dropdown-toggle d-flex align-items-center gap-2 py-1 ps-1.5 pe-2 rounded-pill shadow-xs" type="button" data-bs-toggle="dropdown" aria-expanded="false">
          <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-xs" style="width: 32px; height: 32px; font-size: 0.85rem; font-weight: 700; background: linear-gradient(135deg, #0F6B59, #083D33);">
            <%= user.nama_lengkap ? user.nama_lengkap.charAt(0).toUpperCase() : 'U' %>
          </div>
          <div class="text-start d-none d-md-block pe-1">
            <span class="d-block fw-semibold text-truncate" style="max-width: 140px; font-size: 0.825rem; color: #0F172A;"><%= user.nama_lengkap || user.username %></span>
            <span class="text-muted d-block" style="font-size: 0.7rem; line-height: 1;"><%= user.role %></span>
          </div>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border rounded-3 mt-1 py-1" style="min-width: 220px;">
          <li class="px-3 py-2 border-bottom">
            <div class="fw-bold text-dark" style="font-size: 0.875rem;"><%= user.nama_lengkap || user.username %></div>
            <div class="text-muted small">Username: <span class="font-monospace">@<%= user.username %></span></div>
            <span class="badge bg-light text-dark border px-2 py-0.5 mt-1" style="font-size: 0.7rem;"><i class="bi bi-shield-check text-success me-1"></i><%= user.role %></span>
          </li>
          <li>
            <a class="dropdown-item py-2 small d-flex align-items-center text-danger" href="javascript:void(0)" onclick="handleLogout()">
              <i class="bi bi-box-arrow-right me-2 fs-6"></i> Keluar dari Sistem
            </a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="app-container">
