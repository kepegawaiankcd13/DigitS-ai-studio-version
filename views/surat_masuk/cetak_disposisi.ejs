<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Lembar Disposisi - Agenda #<%= item.id %></title>
  <style>
    @page {
      size: A4 portrait;
      margin: 1.5cm;
    }
    body {
      font-family: 'Times New Roman', Times, serif;
      color: #000;
      background: #fff;
      margin: 0;
      padding: 20px;
      font-size: 13px;
      line-height: 1.35;
    }
    .header-table {
      width: 100%;
      border-bottom: 3px double #000;
      padding-bottom: 10px;
      margin-bottom: 15px;
    }
    .header-logo {
      width: 80px;
      text-align: center;
      vertical-align: middle;
    }
    .header-logo img {
      max-height: 80px;
      width: auto;
    }
    .header-text {
      text-align: center;
      vertical-align: middle;
    }
    .header-text h3 {
      margin: 0;
      font-size: 16px;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .header-text h2 {
      margin: 2px 0;
      font-size: 18px;
      font-weight: bold;
      text-transform: uppercase;
    }
    .header-text p {
      margin: 0;
      font-size: 11px;
    }
    .title {
      text-align: center;
      font-size: 15px;
      font-weight: bold;
      text-decoration: underline;
      margin-bottom: 15px;
      text-transform: uppercase;
    }
    table.data-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 15px;
    }
    table.data-table th, table.data-table td {
      border: 1px solid #000;
      padding: 6px 8px;
      vertical-align: top;
    }
    .checkbox-item {
      display: inline-block;
      min-width: 45%;
      margin-bottom: 4px;
    }
    .box-square {
      display: inline-block;
      width: 12px;
      height: 12px;
      border: 1px solid #000;
      margin-right: 5px;
      vertical-align: middle;
    }
    .checked {
      background: #000;
    }
    .signature-area {
      margin-top: 25px;
      width: 100%;
    }
    .signature-box {
      float: right;
      width: 250px;
      text-align: center;
    }
    .signature-space {
      height: 70px;
    }
    @media print {
      .no-print {
        display: none !important;
      }
      body {
        padding: 0;
      }
    }
  </style>
</head>
<body>

  <!-- Floating Print Control (hidden during print) -->
  <div class="no-print" style="margin-bottom: 20px; text-align: right; background: #f3f4f6; padding: 10px; border-radius: 6px;">
    <button onclick="window.print()" style="background: #0F6B59; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-weight: bold;">
      &#128438; Cetak Dokumen
    </button>
    <button onclick="window.close()" style="background: #6b7280; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer;">
      Tutup
    </button>
  </div>

  <!-- Kop Surat Resmi Jabar KCD XIII -->
  <table class="header-table">
    <tr>
      <td class="header-logo">
        <img src="/images/logo-jabar.png" alt="Logo Jabar" onerror="this.style.display='none'">
      </td>
      <td class="header-text">
        <h3>Pemerintah Daerah Provinsi Jawa Barat</h3>
        <h2>Dinas Pendidikan</h2>
        <h3>Cabang Dinas Pendidikan Wilayah XIII</h3>
        <p>Jalan R.A.A. Sastrawinata No. 1, Ciamis - Jawa Barat</p>
      </td>
    </tr>
  </table>

  <div class="title">LEMBAR DISPOSISI</div>

  <table class="data-table">
    <tr>
      <td style="width: 25%;"><strong>Nomor Agenda</strong></td>
      <td style="width: 25%;"><strong>#<%= item.id %></strong></td>
      <td style="width: 25%;"><strong>Tingkat Urgensi</strong></td>
      <td style="width: 25%;"><strong><%= item.urgensi || 'Biasa' %></strong></td>
    </tr>
    <tr>
      <td><strong>Tanggal Terima</strong></td>
      <td><%= item.tgl_terima %></td>
      <td><strong>Sifat Surat</strong></td>
      <td><%= item.sifat || 'Biasa' %></td>
    </tr>
    <tr>
      <td><strong>Nomor Surat Asli</strong></td>
      <td colspan="3"><%= item.nomor_surat %></td>
    </tr>
    <tr>
      <td><strong>Tanggal Surat</strong></td>
      <td colspan="3"><%= item.tgl_surat %></td>
    </tr>
    <tr>
      <td><strong>Asal Surat / Pengirim</strong></td>
      <td colspan="3"><%= item.pengirim %></td>
    </tr>
    <tr>
      <td><strong>Perihal</strong></td>
      <td colspan="3"><%= item.perihal %></td>
    </tr>
    <% if (item.tgl_pelaksanaan) { %>
      <tr>
        <td><strong>Tanggal Pelaksanaan</strong></td>
        <td colspan="3"><%= item.tgl_pelaksanaan %></td>
      </tr>
    <% } %>
  </table>

  <table class="data-table">
    <thead>
      <tr style="background: #f8f8f8;">
        <th style="width: 50%;">DISPOSISI KEPADA:</th>
        <th style="width: 50%;">PETUNJUK / INSTRUKSI:</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>
          <% const tujuans = ['Kasubag Tata Usaha', 'Kasi Pelayanan SMA', 'Kasi Pelayanan SMK', 'Kasi PKLK', 'Pejabat Pembuat Komitmen (PPK)', 'Bendahara Pengeluaran', 'Kepegawaian', 'Arsiparis']; %>
          <% tujuans.forEach(t => { %>
            <div class="checkbox-item">
              <span class="box-square <%= (item.tujuan_disposisi && item.tujuan_disposisi.includes(t)) ? 'checked' : '' %>"></span>
              <%= t %>
            </div>
          <% }) %>
          <% if (item.tujuan_disposisi) { %>
            <div style="margin-top: 10px; padding-top: 8px; border-top: 1px dashed #ccc; font-style: italic;">
              <strong>Tujuan Tercatat:</strong> <%= item.tujuan_disposisi %>
            </div>
          <% } %>
        </td>
        <td>
          <div class="checkbox-item"><span class="box-square"></span> Tindak lanjuti segera</div>
          <div class="checkbox-item"><span class="box-square"></span> Untuk diketahui / pedoman</div>
          <div class="checkbox-item"><span class="box-square"></span> Siapkan konsep jawaban</div>
          <div class="checkbox-item"><span class="box-square"></span> Koordinasikan</div>
          <div class="checkbox-item"><span class="box-square"></span> Hadiri / Wakili</div>
          <div class="checkbox-item"><span class="box-square"></span> Arsipkan</div>

          <div style="margin-top: 10px; border-top: 1px dashed #ccc; padding-top: 6px;">
            <strong>Catatan Khusus Pimpinan:</strong>
            <p style="margin: 4px 0 0; min-height: 50px;"><%= item.catatan_disposisi || '(Tidak ada catatan khusus)' %></p>
          </div>
        </td>
      </tr>
    </tbody>
  </table>

  <div class="signature-area">
    <div class="signature-box">
      <div>Ciamis, <%= item.tgl_terima %></div>
      <div><strong>Kepala Cabang Dinas Pendidikan<br>Wilayah XIII</strong></div>
      <div class="signature-space"></div>
      <div><strong><u>Drs. H. Hendra Mulyana, M.M.</u></strong></div>
      <div>NIP. 19680712 199303 1 008</div>
    </div>
    <div style="clear: both;"></div>
  </div>

</body>
</html>
