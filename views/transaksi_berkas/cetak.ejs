<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Tanda Terima Berkas - #<%= item.id %></title>
  <style>
    @page {
      size: A5 landscape;
      margin: 1cm;
    }
    body {
      font-family: 'Times New Roman', Times, serif;
      color: #000;
      background: #fff;
      padding: 15px;
      font-size: 13px;
      line-height: 1.4;
    }
    .header-table {
      width: 100%;
      border-bottom: 2px solid #000;
      padding-bottom: 8px;
      margin-bottom: 12px;
    }
    .header-logo {
      width: 60px;
      text-align: center;
      vertical-align: middle;
    }
    .header-logo img {
      max-height: 60px;
      width: auto;
    }
    .header-text {
      text-align: center;
      vertical-align: middle;
    }
    .header-text h4 {
      margin: 0;
      font-size: 13px;
      font-weight: bold;
      text-transform: uppercase;
    }
    .header-text h3 {
      margin: 2px 0;
      font-size: 15px;
      font-weight: bold;
      text-transform: uppercase;
    }
    .header-text p {
      margin: 0;
      font-size: 10px;
    }
    .title {
      text-align: center;
      font-size: 14px;
      font-weight: bold;
      text-decoration: underline;
      margin-bottom: 12px;
      text-transform: uppercase;
    }
    table.data-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 15px;
    }
    table.data-table td {
      padding: 5px 8px;
      vertical-align: top;
    }
    .signatures {
      width: 100%;
      margin-top: 20px;
    }
    .sig-col {
      width: 50%;
      float: left;
      text-align: center;
    }
    .sig-space {
      height: 55px;
    }
    @media print {
      .no-print {
        display: none !important;
      }
      body {
        padding: 0;
      }
    }
  </style>
</head>
<body>

  <div class="no-print" style="margin-bottom: 15px; text-align: right; background: #f3f4f6; padding: 8px; border-radius: 4px;">
    <button onclick="window.print()" style="background: #0F6B59; color: white; border: none; padding: 6px 14px; border-radius: 4px; cursor: pointer; font-weight: bold;">
      &#128438; Cetak Tanda Terima
    </button>
    <button onclick="window.close()" style="background: #6b7280; color: white; border: none; padding: 6px 14px; border-radius: 4px; cursor: pointer;">
      Tutup
    </button>
  </div>

  <table class="header-table">
    <tr>
      <td class="header-logo">
        <img src="/images/logo-jabar.png" alt="Logo Jabar" onerror="this.style.display='none'">
      </td>
      <td class="header-text">
        <h4>Pemerintah Daerah Provinsi Jawa Barat - Dinas Pendidikan</h4>
        <h3>Cabang Dinas Pendidikan Wilayah XIII</h3>
        <p>Jalan R.A.A. Sastrawinata No. 1, Ciamis - Jawa Barat</p>
      </td>
    </tr>
  </table>

  <div class="title">BUKTI TANDA TERIMA BERKAS</div>

  <table class="data-table">
    <tr>
      <td style="width: 25%;"><strong>No. Registrasi</strong></td>
      <td style="width: 3%;">:</td>
      <td style="width: 72%;"><strong>TRB-<%= String(item.id).padStart(5, '0') %></strong></td>
    </tr>
    <tr>
      <td><strong>Tanggal Terima</strong></td>
      <td>:</td>
      <td><%= String(item.tgl_transaksi || '').substring(0, 10) %></td>
    </tr>
    <tr>
      <td><strong>Nama Penyerah</strong></td>
      <td>:</td>
      <td><strong><%= item.Tamu ? item.Tamu.nama : '-' %></strong> (ID: <%= item.Tamu ? item.Tamu.id_tamu : '-' %>)</td>
    </tr>
    <tr>
      <td><strong>Asal Instansi / Unit Kerja</strong></td>
      <td>:</td>
      <td><%= item.Tamu ? item.Tamu.unit_kerja : '-' %></td>
    </tr>
    <tr>
      <td><strong>No. Kontak / WA</strong></td>
      <td>:</td>
      <td><%= item.Tamu ? item.Tamu.no_kontak : '-' %></td>
    </tr>
    <tr>
      <td><strong>Tujuan Berkas</strong></td>
      <td>:</td>
      <td><strong><%= item.tujuan %></strong></td>
    </tr>
    <tr>
      <td><strong>Rincian / Perihal Berkas</strong></td>
      <td>:</td>
      <td><%= item.perihal %></td>
    </tr>
  </table>

  <div class="signatures">
    <div class="sig-col">
      <div>Yang Menyerahkan,</div>
      <div class="sig-space"></div>
      <div><strong>( <%= item.Tamu ? item.Tamu.nama : '................................' %> )</strong></div>
    </div>
    <div class="sig-col">
      <div>Petugas Front Office,</div>
      <div class="sig-space"></div>
      <div><strong>( <%= item.penerima %> )</strong></div>
    </div>
    <div style="clear: both;"></div>
  </div>

  <div style="margin-top: 15px; font-size: 10px; color: #555; text-align: center; border-top: 1px dotted #999; padding-top: 4px;">
    Simpan tanda terima ini sebagai bukti sah penyerahan berkas fisik di Cabang Dinas Pendidikan Wilayah XIII.
  </div>

</body>
</html>
