<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1">
      <span class="badge bg-danger bg-opacity-10 text-danger fw-bold px-2 py-1 rounded" style="font-size: 0.75rem;">
        <i class="bi bi-shield-lock-fill me-1"></i> Hak Akses & Administrator
      </span>
      <h4 class="fw-bold mb-0 text-dark">Manajemen Pengguna Sistem</h4>
    </div>
    <p class="text-muted small mb-0">Kelola akun staf, petugas persuratan, dan front office Cabang Dinas Wilayah XIII</p>
  </div>
  <div class="mt-3 mt-md-0 d-flex gap-2">
    <button class="btn btn-sm btn-primary-custom d-inline-flex align-items-center shadow-sm" data-bs-toggle="modal" data-bs-target="#addUserModal">
      <i class="bi bi-person-plus-fill me-1.5"></i> Tambah Pengguna Baru
    </button>
  </div>
</div>

<!-- Table Card -->
<div class="card card-modern overflow-hidden">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-modern align-middle mb-0">
        <thead>
          <tr>
            <th class="ps-3" style="width: 70px;">ID</th>
            <th>Pengguna & Akun</th>
            <th>Nama Lengkap Staf</th>
            <th>Hak Akses (Role)</th>
            <th style="width: 120px;">Dibuat</th>
            <th class="text-end pe-3" style="width: 120px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td class="ps-3">
                <span class="badge bg-light text-dark border font-tabular" style="font-size: 0.725rem;">
                  #<%= u.id %>
                </span>
              </td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 32px; height: 32px; font-size: 0.8rem; font-weight: 700; background: linear-gradient(135deg, #0F6B59, #083D33);">
                    <%= u.username ? u.username.charAt(0).toUpperCase() : 'U' %>
                  </div>
                  <div>
                    <span class="fw-bold font-monospace text-dark d-block" style="font-size: 0.85rem;">@<%= u.username %></span>
                  </div>
                </div>
              </td>
              <td>
                <span class="fw-semibold text-dark" style="font-size: 0.85rem;"><%= u.nama_lengkap || '-' %></span>
              </td>
              <td>
                <% if (u.role === 'admin') { %>
                  <span class="badge badge-soft-rose px-2.5 py-0.5 rounded-pill" style="font-size: 0.725rem;"><i class="bi bi-shield-lock-fill me-1"></i>Administrator</span>
                <% } else if (u.role === 'Front Office') { %>
                  <span class="badge badge-soft-blue px-2.5 py-0.5 rounded-pill" style="font-size: 0.725rem;"><i class="bi bi-person-badge me-1"></i>Front Office</span>
                <% } else { %>
                  <span class="badge badge-soft-emerald px-2.5 py-0.5 rounded-pill" style="font-size: 0.725rem;"><i class="bi bi-envelope-paper-fill me-1"></i><%= u.role %></span>
                <% } %>
              </td>
              <td class="font-tabular text-muted small" style="font-size: 0.75rem;">
                <%= String(u.createdAt || '').substring(0, 10) %>
              </td>
              <td class="text-end pe-3 text-nowrap">
                <div class="btn-group btn-group-sm">
                  <button class="btn btn-outline-dark py-1 px-2" title="Edit Pengguna" data-bs-toggle="modal" data-bs-target="#editModal<%= u.id %>">
                    <i class="bi bi-pencil"></i>
                  </button>
                  <% if (u.username !== 'admin') { %>
                    <form action="/users/<%= u.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Hapus pengguna @<%= u.username %>?')">
                      <button type="submit" class="btn btn-outline-danger py-1 px-2" title="Hapus"><i class="bi bi-trash"></i></button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>

            <!-- Modal Edit User -->
            <div class="modal fade" id="editModal<%= u.id %>" tabindex="-1">
              <div class="modal-dialog">
                <div class="modal-content rounded-3 border-0 shadow">
                  <form action="/users/<%= u.id %>/edit" method="POST">
                    <div class="modal-header border-bottom">
                      <h6 class="modal-title fw-bold text-dark">Ubah Pengguna @<%= u.username %></h6>
                      <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-3">
                      <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Username</label>
                        <input type="text" name="username" class="form-control form-control-sm" value="<%= u.username %>" required>
                      </div>
                      <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Nama Lengkap</label>
                        <input type="text" name="nama_lengkap" class="form-control form-control-sm" value="<%= u.nama_lengkap || '' %>" required>
                      </div>
                      <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Role / Hak Akses</label>
                        <select name="role" class="form-select form-select-sm" required>
                          <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Administrator</option>
                          <option value="Front Office" <%= u.role === 'Front Office' ? 'selected' : '' %>>Front Office</option>
                          <option value="Persuratan" <%= u.role === 'Persuratan' ? 'selected' : '' %>>Persuratan</option>
                          <option value="Staff" <%= u.role === 'Staff' ? 'selected' : '' %>>Staff</option>
                        </select>
                      </div>
                      <div class="mb-2">
                        <label class="form-label small fw-semibold text-secondary">Password Baru (Kosongkan bila tidak diganti)</label>
                        <input type="password" name="password" class="form-control form-control-sm" placeholder="Masukkan password baru jika ingin mengubah">
                      </div>
                    </div>
                    <div class="modal-footer border-top p-2 bg-light">
                      <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Batal</button>
                      <button type="submit" class="btn btn-sm btn-primary-custom">Simpan Perubahan</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Add User -->
<div class="modal fade" id="addUserModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content rounded-3 border-0 shadow">
      <form action="/users" method="POST">
        <div class="modal-header border-bottom">
          <h6 class="modal-title fw-bold text-dark"><i class="bi bi-person-plus text-success me-1"></i> Tambah Pengguna Baru</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-3">
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Username</label>
            <input type="text" name="username" class="form-control form-control-sm" placeholder="Contoh: lukman_kcd" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Nama Lengkap</label>
            <input type="text" name="nama_lengkap" class="form-control form-control-sm" placeholder="Contoh: Lukman Hakim, S.Pd." required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">Password</label>
            <input type="password" name="password" class="form-control form-control-sm" placeholder="Password akun" required>
          </div>
          <div class="mb-2">
            <label class="form-label small fw-semibold text-secondary">Role / Hak Akses</label>
            <select name="role" class="form-select form-select-sm" required>
              <option value="Front Office">Front Office</option>
              <option value="Persuratan" selected>Persuratan</option>
              <option value="Staff">Staff</option>
              <option value="admin">Administrator</option>
            </select>
          </div>
        </div>
        <div class="modal-footer border-top p-2 bg-light">
          <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Batal</button>
          <button type="submit" class="btn btn-sm btn-primary-custom">Simpan Pengguna</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
