<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1">
      <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1 rounded" style="font-size: 0.75rem;">
        <i class="bi bi-bookmarks-fill me-1"></i> Tata Naskah Dinas
      </span>
      <h4 class="fw-bold mb-0 text-dark">Kode Klasifikasi Arsip Naskah Dinas</h4>
    </div>
    <p class="text-muted small mb-0">Rujukan standar kode penomoran surat kedinasan (Permendagri & Pedoman Tata Naskah Dinas Provinsi Jawa Barat)</p>
  </div>
</div>

<!-- Search -->
<div class="card card-modern mb-4">
  <div class="card-body p-3">
    <form action="/klasifikasi" method="GET" class="row g-2 align-items-center">
      <div class="col-md-10">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
          <input type="text" name="search" class="form-control border-start-0" placeholder="Cari kode (misal: 005, 421, HM, TU, PK) atau uraian perihal..." value="<%= search %>">
        </div>
      </div>
      <div class="col-md-2 d-flex gap-1">
        <button type="submit" class="btn btn-sm btn-dark w-100 fw-semibold">
          <i class="bi bi-search me-1"></i> Cari Kode
        </button>
        <% if (search) { %>
          <a href="/klasifikasi" class="btn btn-sm btn-outline-secondary" title="Reset">
            <i class="bi bi-x-circle"></i>
          </a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Table Card -->
<div class="card card-modern overflow-hidden">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-modern align-middle mb-0">
        <thead>
          <tr>
            <th class="ps-3" style="width: 160px;">Kode Klasifikasi</th>
            <th>Uraian / Deskripsi Pokok Persoalan</th>
          </tr>
        </thead>
        <tbody>
          <% if (items && items.length > 0) { %>
            <% items.forEach(k => { %>
              <tr>
                <td class="ps-3">
                  <span class="badge badge-soft-emerald font-tabular px-2.5 py-1" style="font-size: 0.8rem;">
                    <%= k.kode %>
                  </span>
                </td>
                <td>
                  <div class="fw-medium text-dark" style="font-size: 0.85rem; line-height: 1.45;">
                    <%= k.nama %>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="2" class="text-center text-muted py-5">
                <i class="bi bi-bookmarks fs-2 d-block mb-2 text-secondary opacity-50"></i>
                Tidak ditemukan kode klasifikasi yang sesuai.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="d-flex align-items-center justify-content-between p-3 border-top">
        <small class="text-muted">Halaman <%= currentPage %> dari <%= totalPages %> (Total <%= totalCount %> kode klasifikasi)</small>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/klasifikasi?page=<%= currentPage - 1 %>&search=<%= search %>">Sebelumnya</a>
          </li>
          <li class="page-item active">
            <span class="page-link bg-success border-success"><%= currentPage %></span>
          </li>
          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/klasifikasi?page=<%= currentPage + 1 %>&search=<%= search %>">Selanjutnya</a>
          </li>
        </ul>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
