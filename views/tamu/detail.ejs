<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
  <div>
    <h4 class="fw-bold mb-1">Profil Tamu & Riwayat Berkas</h4>
    <p class="text-muted small mb-0"><%= tamu.id_tamu %> &mdash; <%= tamu.nama %></p>
  </div>
  <div class="d-flex gap-2">
    <a href="/transaksi-berkas/create?tamuId=<%= tamu.id %>" class="btn btn-sm btn-success">
      <i class="bi bi-file-earmark-plus me-1"></i> Terima Berkas Baru
    </a>
    <a href="/tamu" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
  </div>
</div>

<div class="row g-4 mb-4">
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-body p-4 text-center border-bottom">
        <div class="rounded-circle bg-primary-subtle text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px; font-size: 2rem;">
          <i class="bi bi-person"></i>
        </div>
        <h5 class="fw-bold mb-1"><%= tamu.nama %></h5>
        <div class="badge badge-soft-primary mb-2 font-monospace"><%= tamu.id_tamu %></div>
        <div class="text-muted small"><%= tamu.unit_kerja %></div>
      </div>
      <div class="card-body p-3 small">
        <table class="table table-sm table-borderless mb-0">
          <tr>
            <td class="text-muted">NIP:</td>
            <td class="fw-semibold font-monospace"><%= tamu.nip || '-' %></td>
          </tr>
          <tr>
            <td class="text-muted">Jabatan:</td>
            <td><%= tamu.jabatan || '-' %></td>
          </tr>
          <tr>
            <td class="text-muted">Pekerjaan:</td>
            <td><%= tamu.pekerjaan || '-' %></td>
          </tr>
          <tr>
            <td class="text-muted">Kontak:</td>
            <td>
              <% if (tamu.no_kontak && tamu.no_kontak !== '-') { %>
                <a href="https://wa.me/<%= String(tamu.no_kontak).replace(/[^0-9]/g, '') %>" target="_blank" class="text-decoration-none text-success fw-semibold">
                  <i class="bi bi-whatsapp"></i> <%= tamu.no_kontak %>
                </a>
              <% } else { %>
                -
              <% } %>
            </td>
          </tr>
          <tr>
            <td class="text-muted">Terdaftar:</td>
            <td><%= String(tamu.createdAt || '').substring(0, 10) %></td>
          </tr>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card border-0 shadow-sm rounded-3">
      <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-folder-check text-warning me-2"></i>Daftar Berkas yang Pernah Diserahkan</h6>
        <span class="badge badge-soft-secondary"><%= berkas.length %> Dokumen</span>
      </div>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
          <thead class="table-light">
            <tr>
              <th>Tgl Transaksi</th>
              <th>Perihal Berkas</th>
              <th>Tujuan Bagian</th>
              <th>Penerima (FO)</th>
              <th class="text-end">Cetak</th>
            </tr>
          </thead>
          <tbody>
            <% if (berkas && berkas.length > 0) { %>
              <% berkas.forEach(b => { %>
                <tr>
                  <td class="text-nowrap fw-semibold"><%= String(b.tgl_transaksi || '').substring(0, 10) %></td>
                  <td><%= b.perihal %></td>
                  <td><span class="badge badge-soft-info"><%= b.tujuan %></span></td>
                  <td><%= b.penerima %></td>
                  <td class="text-end">
                    <a href="/transaksi-berkas/<%= b.id %>/cetak" target="_blank" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Cetak Tanda Terima">
                      <i class="bi bi-printer"></i>
                    </a>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center text-muted py-4">Belum ada riwayat transaksi berkas untuk tamu ini</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
