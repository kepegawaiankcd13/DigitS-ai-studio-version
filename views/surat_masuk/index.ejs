<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
  <div>
    <h4 class="fw-bold mb-1">Buku Agenda Surat Masuk</h4>
    <p class="text-muted small mb-0">Pencatatan surat masuk, pengelolaan lembar disposisi pimpinan, dan pengarsipan digital</p>
  </div>
  <div class="mt-3 mt-md-0 d-flex gap-2">
    <a href="/surat-masuk/export" class="btn btn-outline-success btn-sm">
      <i class="bi bi-file-earmark-excel me-1"></i> Ekspor Excel
    </a>
    <a href="/surat-masuk/create" class="btn btn-success btn-sm">
      <i class="bi bi-plus-circle me-1"></i> Catat Surat Masuk
    </a>
  </div>
</div>

<!-- Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <form action="/surat-masuk" method="GET" class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
          <input type="text" name="search" class="form-control" placeholder="Cari nomor surat, pengirim, atau perihal..." value="<%= search %>">
        </div>
      </div>
      <div class="col-md-3">
        <select name="status_disposisi" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">Semua Status Disposisi</option>
          <option value="1" <%= statusDisposisi === '1' ? 'selected' : '' %>>Sudah Disposisi</option>
          <option value="0" <%= statusDisposisi === '0' ? 'selected' : '' %>>Belum Disposisi</option>
        </select>
      </div>
      <div class="col-md-3">
        <select name="urgensi" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">Semua Urgensi</option>
          <option value="Amat Segera" <%= urgensi === 'Amat Segera' ? 'selected' : '' %>>Amat Segera</option>
          <option value="Segera" <%= urgensi === 'Segera' ? 'selected' : '' %>>Segera</option>
          <option value="Penting" <%= urgensi === 'Penting' ? 'selected' : '' %>>Penting</option>
          <option value="Biasa" <%= urgensi === 'Biasa' ? 'selected' : '' %>>Biasa</option>
        </select>
      </div>
      <div class="col-md-1 d-grid">
        <button type="submit" class="btn btn-sm btn-dark">Filter</button>
      </div>
    </form>
  </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size: 0.85rem;">
        <thead class="table-light">
          <tr>
            <th style="width: 60px;">No. Agenda</th>
            <th style="width: 100px;">Tgl Terima</th>
            <th>Nomor & Tgl Surat</th>
            <th>Pengirim & Perihal</th>
            <th>Sifat / Urgensi</th>
            <th>Disposisi</th>
            <th>Berkas PDF</th>
            <th class="text-end" style="width: 130px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (items && items.length > 0) { %>
            <% items.forEach(s => { %>
              <tr>
                <td class="fw-bold text-center text-muted"><%= s.id %></td>
                <td class="text-nowrap fw-semibold"><%= s.tgl_terima %></td>
                <td>
                  <div class="fw-bold font-monospace text-dark"><%= s.nomor_surat %></div>
                  <small class="text-muted"><i class="bi bi-calendar-event me-1"></i><%= s.tgl_surat %></small>
                </td>
                <td>
                  <div class="fw-semibold text-primary text-truncate" style="max-width: 280px;" title="<%= s.pengirim %>"><%= s.pengirim %></div>
                  <div class="text-dark small text-truncate" style="max-width: 280px;" title="<%= s.perihal %>"><%= s.perihal %></div>
                  <% if (s.tgl_pelaksanaan) { %>
                    <small class="text-muted d-block"><i class="bi bi-clock me-1"></i>Pelaksanaan: <%= s.tgl_pelaksanaan %></small>
                  <% } %>
                </td>
                <td>
                  <% if (s.urgensi === 'Amat Segera') { %>
                    <span class="badge badge-soft-danger">Amat Segera</span>
                  <% } else if (s.urgensi === 'Segera' || s.urgensi === 'Penting') { %>
                    <span class="badge badge-soft-warning"><%= s.urgensi %></span>
                  <% } else { %>
                    <span class="badge badge-soft-secondary">Biasa</span>
                  <% } %>
                  <small class="d-block text-muted mt-1"><%= s.sifat %></small>
                </td>
                <td>
                  <% if (s.status_disposisi == 1 || s.status_disposisi === true) { %>
                    <span class="badge badge-soft-success"><i class="bi bi-check2-circle me-1"></i>Sudah</span>
                    <% if (s.tujuan_disposisi) { %>
                      <small class="d-block text-muted text-truncate" style="max-width: 120px;" title="<%= s.tujuan_disposisi %>"><%= s.tujuan_disposisi %></small>
                    <% } %>
                  <% } else { %>
                    <span class="badge badge-soft-warning"><i class="bi bi-hourglass me-1"></i>Belum</span>
                  <% } %>
                </td>
                <td>
                  <% if (s.file_pdf) { %>
                    <a href="/uploads/surat_masuk/<%= s.file_pdf %>" target="_blank" class="btn btn-sm btn-outline-danger py-0 px-2" title="Lihat Berkas PDF">
                      <i class="bi bi-file-earmark-pdf me-1"></i>Lihat
                    </a>
                  <% } else { %>
                    <span class="text-muted small">-</span>
                  <% } %>
                </td>
                <td class="text-end text-nowrap">
                  <div class="btn-group btn-group-sm">
                    <a href="/surat-masuk/<%= s.id %>/disposisi" class="btn btn-outline-primary py-0 px-2" title="Isi / Perbarui Disposisi">
                      <i class="bi bi-pencil-square"></i>
                    </a>
                    <a href="/surat-masuk/<%= s.id %>/cetak-disposisi" target="_blank" class="btn btn-outline-secondary py-0 px-2" title="Cetak Lembar Disposisi">
                      <i class="bi bi-printer"></i>
                    </a>
                    <a href="/surat-masuk/<%= s.id %>/edit" class="btn btn-outline-dark py-0 px-2" title="Edit Data Surat">
                      <i class="bi bi-gear"></i>
                    </a>
                    <form action="/surat-masuk/<%= s.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Hapus surat masuk nomor agenda <%= s.id %>?')">
                      <button type="submit" class="btn btn-outline-danger py-0 px-2" title="Hapus"><i class="bi bi-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center text-muted py-4">Tidak ada data surat masuk ditemukan</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="d-flex align-items-center justify-content-between p-3 border-top">
        <small class="text-muted">Halaman <%= currentPage %> dari <%= totalPages %> (Total <%= totalCount %> surat)</small>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/surat-masuk?page=<%= currentPage - 1 %>&search=<%= search %>&status_disposisi=<%= statusDisposisi %>&urgensi=<%= urgensi %>">Sebelumnya</a>
          </li>
          <li class="page-item active">
            <span class="page-link bg-success border-success"><%= currentPage %></span>
          </li>
          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/surat-masuk?page=<%= currentPage + 1 %>&search=<%= search %>&status_disposisi=<%= statusDisposisi %>&urgensi=<%= urgensi %>">Selanjutnya</a>
          </li>
        </ul>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
