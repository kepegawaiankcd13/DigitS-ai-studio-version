<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
  <div>
    <div class="d-flex align-items-center gap-2 mb-1">
      <span class="badge bg-success bg-opacity-10 text-success fw-bold px-2 py-1 rounded" style="font-size: 0.75rem;">
        <i class="bi bi-hash me-1"></i> Tata Naskah Dinas
      </span>
      <h4 class="fw-bold mb-0 text-dark">Agenda Nomor Surat Keluar</h4>
    </div>
    <p class="text-muted small mb-0">Pengambilan nomor surat resmi, booking nomor urut, dan pengarsipan naskah keluar KCD Wilayah XIII</p>
  </div>
  <div class="mt-3 mt-md-0 d-flex gap-2">
    <a href="/transaksi-surat/export" class="btn btn-sm btn-outline-custom d-inline-flex align-items-center">
      <i class="bi bi-file-earmark-excel text-success me-1.5"></i> Ekspor Excel
    </a>
    <a href="/transaksi-surat/create" class="btn btn-sm btn-primary-custom d-inline-flex align-items-center shadow-sm">
      <i class="bi bi-plus-circle me-1.5"></i> Ambil Nomor Baru
    </a>
  </div>
</div>

<!-- Filters -->
<div class="card card-modern mb-4">
  <div class="card-body p-3">
    <form action="/transaksi-surat" method="GET" class="row g-2 align-items-center">
      <div class="col-md-5">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
          <input type="text" name="search" class="form-control border-start-0" placeholder="Cari nomor surat atau perihal..." value="<%= search %>">
        </div>
      </div>
      <div class="col-md-3">
        <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">Semua Status Nomor</option>
          <option value="Aktif" <%= status === 'Aktif' ? 'selected' : '' %>>Aktif (Sudah Digunakan)</option>
          <option value="Booking" <%= status === 'Booking' ? 'selected' : '' %>>Booking (Dipesan)</option>
        </select>
      </div>
      <div class="col-md-3">
        <select name="jenisId" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">Semua Jenis Naskah</option>
          <% jenisSurats.forEach(j => { %>
            <option value="<%= j.id %>" <%= String(jenisId) === String(j.id) ? 'selected' : '' %>><%= j.nama_jenis %> (<%= j.kode_jenis %>)</option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-1 d-flex gap-1">
        <button type="submit" class="btn btn-sm btn-dark w-100 fw-semibold">
          <i class="bi bi-funnel"></i>
        </button>
        <% if (search || status || jenisId) { %>
          <a href="/transaksi-surat" class="btn btn-sm btn-outline-secondary" title="Reset Filter">
            <i class="bi bi-x-circle"></i>
          </a>
        <% } %>
      </div>
    </form>
  </div>
</div>

<!-- Table Card -->
<div class="card card-modern overflow-hidden">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-modern align-middle mb-0">
        <thead>
          <tr>
            <th class="ps-3" style="width: 75px;">Urut</th>
            <th>Nomor Surat Lengkap</th>
            <th style="width: 105px;">Tanggal</th>
            <th>Perihal & Klasifikasi</th>
            <th style="width: 100px;">Status</th>
            <th style="width: 80px;">Berkas</th>
            <th style="width: 120px;">Petugas</th>
            <th class="text-end pe-3" style="width: 110px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (items && items.length > 0) { %>
            <% items.forEach(item => { %>
              <tr>
                <td class="ps-3">
                  <span class="badge bg-light text-dark border font-tabular" style="font-size: 0.725rem;">
                    #<%= String(item.nomor_urut).padStart(4, '0') %>
                  </span>
                </td>
                <td>
                  <span class="fw-bold font-monospace text-dark text-nowrap" style="font-size: 0.825rem;">
                    <%= item.nomor_lengkap || item.nomor_urut %>
                  </span>
                  <% if (item.JenisSurat) { %>
                    <span class="badge badge-soft-blue ms-1" style="font-size: 0.675rem;"><%= item.JenisSurat.kode_jenis %></span>
                  <% } %>
                </td>
                <td class="font-tabular text-secondary text-nowrap" style="font-size: 0.775rem;">
                  <%= item.tanggal_nomor %>
                </td>
                <td>
                  <div class="fw-bold text-dark text-truncate" style="max-width: 320px; font-size: 0.825rem;">
                    <%= item.perihal || '(Nomor Belum Digunakan)' %>
                  </div>
                  <% if (item.Klasifikasi) { %>
                    <small class="text-muted d-block text-truncate" style="max-width: 320px; font-size: 0.725rem;">
                      <i class="bi bi-tag me-1"></i><%= item.Klasifikasi.kode %> &bull; <%= item.Klasifikasi.nama %>
                    </small>
                  <% } %>
                </td>
                <td>
                  <% if (item.status === 'Aktif') { %>
                    <span class="badge badge-soft-emerald px-2 py-0.5 rounded-pill" style="font-size: 0.7rem;">
                      <i class="bi bi-check-circle-fill me-1"></i>Aktif
                    </span>
                  <% } else { %>
                    <span class="badge badge-soft-amber px-2 py-0.5 rounded-pill" style="font-size: 0.7rem;">
                      <i class="bi bi-bookmark-fill me-1"></i>Booking
                    </span>
                  <% } %>
                </td>
                <td>
                  <% if (item.file_pdf) { %>
                    <a href="/uploads/surat_masuk/<%= item.file_pdf %>" target="_blank" class="btn btn-sm btn-outline-danger py-0.5 px-2 d-inline-flex align-items-center gap-1 shadow-2xs" style="font-size: 0.725rem;" title="Lihat Berkas PDF">
                      <i class="bi bi-file-earmark-pdf-fill"></i> PDF
                    </a>
                  <% } else { %>
                    <span class="text-muted small">-</span>
                  <% } %>
                </td>
                <td>
                  <span class="text-secondary small d-flex align-items-center gap-1" style="font-size: 0.75rem;">
                    <i class="bi bi-person text-muted"></i><%= item.User ? item.User.nama_lengkap : '-' %>
                  </span>
                </td>
                <td class="text-end pe-3 text-nowrap">
                  <div class="btn-group btn-group-sm">
                    <% if (item.status === 'Booking') { %>
                      <button class="btn btn-outline-success py-1 px-2" title="Lengkapi / Pakai Nomor" data-bs-toggle="modal" data-bs-target="#completeModal<%= item.id %>">
                        <i class="bi bi-check-lg"></i>
                      </button>
                    <% } %>
                    <form action="/transaksi-surat/<%= item.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus nomor ini?')">
                      <button type="submit" class="btn btn-outline-danger py-1 px-2" title="Hapus"><i class="bi bi-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>

              <!-- Modal Complete Booking -->
              <% if (item.status === 'Booking') { %>
                <div class="modal fade" id="completeModal<%= item.id %>" tabindex="-1">
                  <div class="modal-dialog">
                    <div class="modal-content rounded-3 border-0 shadow">
                      <form action="/transaksi-surat/<%= item.id %>/complete" method="POST" enctype="multipart/form-data">
                        <div class="modal-header border-bottom">
                          <h6 class="modal-title fw-bold text-dark">Lengkapi Penggunaan Nomor <%= String(item.nomor_urut).padStart(4, '0') %></h6>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-3">
                          <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Kode Klasifikasi Arsip</label>
                            <input type="text" class="form-control form-control-sm klas-search" data-target="klasId<%= item.id %>" placeholder="Ketik kode atau nama klasifikasi..." required>
                            <input type="hidden" name="klasifikasiId" id="klasId<%= item.id %>" required>
                            <div class="form-text small klas-selected-label text-success mt-1"></div>
                          </div>
                          <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Perihal Surat</label>
                            <textarea name="perihal" class="form-control form-control-sm" rows="3" placeholder="Masukkan perihal surat..." required></textarea>
                          </div>
                          <div class="mb-2">
                            <label class="form-label small fw-semibold text-secondary">Unggah Berkas PDF (Opsional)</label>
                            <input type="file" name="file_pdf" class="form-control form-control-sm" accept="application/pdf">
                          </div>
                        </div>
                        <div class="modal-footer border-top p-2 bg-light">
                          <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Batal</button>
                          <button type="submit" class="btn btn-sm btn-primary-custom">Gunakan Nomor</button>
                        </div>
                      </form>
                    </div>
                  </div>
                </div>
              <% } %>

            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center text-muted py-5">
                <i class="bi bi-hash fs-2 d-block mb-2 text-secondary opacity-50"></i>
                Tidak ada data penomoran surat yang sesuai.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="d-flex align-items-center justify-content-between p-3 border-top">
        <small class="text-muted">Halaman <%= currentPage %> dari <%= totalPages %> (Total <%= totalCount %> nomor surat)</small>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/transaksi-surat?page=<%= currentPage - 1 %>&search=<%= search %>&status=<%= status %>&jenisId=<%= jenisId %>">Sebelumnya</a>
          </li>
          <li class="page-item active">
            <span class="page-link bg-success border-success"><%= currentPage %></span>
          </li>
          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/transaksi-surat?page=<%= currentPage + 1 %>&search=<%= search %>&status=<%= status %>&jenisId=<%= jenisId %>">Selanjutnya</a>
          </li>
        </ul>
      </div>
    <% } %>
  </div>
</div>

<script>
  document.querySelectorAll('.klas-search').forEach(input => {
    input.addEventListener('input', async function() {
      const q = this.value;
      const targetId = this.dataset.target;
      const label = this.parentElement.querySelector('.klas-selected-label');
      if (q.length < 2) return;
      try {
        const res = await fetch('/api/klasifikasi/search?q=' + encodeURIComponent(q));
        const list = await res.json();
        if (list.length > 0) {
          document.getElementById(targetId).value = list[0].id;
          label.textContent = 'Dipilih: ' + list[0].kode + ' - ' + list[0].nama;
        }
      } catch (e) {}
    });
  });
</script>

<%- include('../partials/footer') %>
