<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between pb-3 mb-4 border-bottom">
  <div>
    <h4 class="fw-bold mb-1">Transaksi Berkas Masuk (Front Office)</h4>
    <p class="text-muted small mb-0">Pencatatan penyerahan berkas fisik dari tamu/sekolah beserta bukti tanda terima</p>
  </div>
  <div class="mt-3 mt-md-0 d-flex gap-2">
    <a href="/transaksi-berkas/create" class="btn btn-success btn-sm">
      <i class="bi bi-file-earmark-plus me-1"></i> Terima Berkas Baru
    </a>
  </div>
</div>

<!-- Search & Filters -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
  <div class="card-body p-3">
    <form action="/transaksi-berkas" method="GET" class="row g-2 align-items-center">
      <div class="col-md-6">
        <div class="input-group input-group-sm">
          <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
          <input type="text" name="search" class="form-control" placeholder="Cari nama tamu, perihal, atau petugas FO..." value="<%= search %>">
        </div>
      </div>
      <div class="col-md-4">
        <select name="tujuan" class="form-select form-select-sm" onchange="this.form.submit()">
          <option value="">Semua Bagian Tujuan</option>
          <option value="Kepegawaian" <%= tujuan === 'Kepegawaian' ? 'selected' : '' %>>Kepegawaian</option>
          <option value="Bagian SMA" <%= tujuan === 'Bagian SMA' ? 'selected' : '' %>>Bagian SMA</option>
          <option value="Bagian SMK" <%= tujuan === 'Bagian SMK' ? 'selected' : '' %>>Bagian SMK</option>
          <option value="Bagian PKLK" <%= tujuan === 'Bagian PKLK' ? 'selected' : '' %>>Bagian PKLK</option>
          <option value="Aset" <%= tujuan === 'Aset' ? 'selected' : '' %>>Aset</option>
          <option value="Keuangan" <%= tujuan === 'Keuangan' ? 'selected' : '' %>>Keuangan</option>
          <option value="Lainnya" <%= tujuan === 'Lainnya' ? 'selected' : '' %>>Lainnya</option>
        </select>
      </div>
      <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-sm btn-dark">Filter</button>
      </div>
    </form>
  </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm rounded-3">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size: 0.875rem;">
        <thead class="table-light">
          <tr>
            <th style="width: 100px;">Tanggal</th>
            <th>Tamu / Asal Instansi</th>
            <th>Perihal Berkas</th>
            <th>Tujuan Bagian</th>
            <th>Penerima FO</th>
            <th class="text-end" style="width: 110px;">Aksi</th>
          </tr>
        </thead>
        <tbody>
          <% if (items && items.length > 0) { %>
            <% items.forEach(b => { %>
              <tr>
                <td class="text-nowrap fw-semibold"><%= String(b.tgl_transaksi || '').substring(0, 10) %></td>
                <td>
                  <% if (b.Tamu) { %>
                    <a href="/tamu/<%= b.Tamu.id %>" class="fw-bold text-dark text-decoration-none">
                      <%= b.Tamu.nama %>
                    </a>
                    <small class="text-muted d-block"><%= b.Tamu.unit_kerja %></small>
                  <% } else { %>
                    <span class="text-muted">-</span>
                  <% } %>
                </td>
                <td>
                  <div class="text-dark" style="max-width: 400px;"><%= b.perihal %></div>
                </td>
                <td>
                  <span class="badge badge-soft-info"><%= b.tujuan %></span>
                </td>
                <td>
                  <span class="small text-secondary"><i class="bi bi-person me-1"></i><%= b.penerima %></span>
                </td>
                <td class="text-end text-nowrap">
                  <div class="btn-group btn-group-sm">
                    <a href="/transaksi-berkas/<%= b.id %>/cetak" target="_blank" class="btn btn-outline-secondary py-0 px-2" title="Cetak Tanda Terima">
                      <i class="bi bi-printer"></i>
                    </a>
                    <form action="/transaksi-berkas/<%= b.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Hapus transaksi berkas ini?')">
                      <button type="submit" class="btn btn-outline-danger py-0 px-2" title="Hapus"><i class="bi bi-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center text-muted py-4">Belum ada transaksi berkas ditemukan</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
      <div class="d-flex align-items-center justify-content-between p-3 border-top">
        <small class="text-muted">Halaman <%= currentPage %> dari <%= totalPages %> (Total <%= totalCount %> transaksi berkas)</small>
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
            <a class="page-link" href="/transaksi-berkas?page=<%= currentPage - 1 %>&search=<%= search %>&tujuan=<%= tujuan %>">Sebelumnya</a>
          </li>
          <li class="page-item active">
            <span class="page-link bg-success border-success"><%= currentPage %></span>
          </li>
          <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
            <a class="page-link" href="/transaksi-berkas?page=<%= currentPage + 1 %>&search=<%= search %>&tujuan=<%= tujuan %>">Selanjutnya</a>
          </li>
        </ul>
      </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
